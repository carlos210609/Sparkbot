SPARKBOT_API_KEY=replace-with-a-long-random-secret
SPARKBOT_ALLOW_INSECURE_LOCAL=false
SPARKBOT_DB_PATH=data/sparkbot.db

# AI defaults: NVIDIA API Catalog
SPARKBOT_AI_PROVIDER=nvidia
NVIDIA_API_KEY=
# auto selects the best available model from the configured NVIDIA preference list.
SPARKBOT_NVIDIA_MODEL=auto
SPARKBOT_AI_TIMEOUT=45
